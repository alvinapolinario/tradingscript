LOCAL_API_TOKEN=local-dev-token-change-me
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://187.77.142.118:8000
# Optional cloud LLM — NEVER put this in the EA or browser
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-sol
USE_LLM=false
MAX_RESPONSE_AGE_SECONDS=120
# Position risk bands (% of equity at SL)
RISK_LOW_MAX_PCT=1.0
RISK_MODERATE_MAX_PCT=2.0
RISK_HIGH_MAX_PCT=5.0
RISK_VERY_HIGH_MAX_PCT=10.0
MAX_POSITION_RISK_PCT=2.0
FLOAT_PROFIT_TARGET_PCT=10.0
RSI_EXHAUST=32.0

# Telegram Bot alerts (backend only — create via @BotFather)
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_COOLDOWN_SEC=300
TELEGRAM_ALERT_RISK=true
TELEGRAM_ALERT_FLOAT_TARGET=true
TELEGRAM_ALERT_ENTRY=true
TELEGRAM_ALERT_SIGNALS=true
TELEGRAM_ALERT_SWING=true
TELEGRAM_ALERT_LIQUIDITY_GRAB=true
TELEGRAM_ALERT_GOLD_SMC=true
TELEGRAM_ALERT_EXECUTION=true
TELEGRAM_GOLD_SMC_MIN_SCORE=75.0

# Discord webhook alerts (backend only — channel → Integrations → Webhooks)
DISCORD_ENABLED=false
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdef...
DISCORD_COOLDOWN_SEC=300
# Background mode: only actionable trades to Discord (no WATCH / entry / per-module noise)
DISCORD_TRADES_ONLY=true
DISCORD_TRADES_MIN_SWING_CONF=72.0

# Box Theory — dedicated Discord webhook (analysis only)
# DISCORD_BOX_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_BOX_ALERTS_ENABLED=false
# DISCORD_BOX_ALERT_EVENTS=

# ICT Strategy — dedicated Discord webhook (state-change alerts only)
# DISCORD_ICT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_ICT_ALERTS_ENABLED=false
# DISCORD_ICT_MIN_CONFIDENCE=75
# DISCORD_ICT_COOLDOWN_SEC=300
# DISCORD_ICT_ALERT_EVENTS=

# Multi-strategy confluence (optional — enhances master verdict when enabled)
# CONFLUENCE_ENABLED=false
# CONFLUENCE_FRESHNESS_THRESHOLD_SEC=900
# CONFLUENCE_MIN_AGREEING_STRONG=2
# CONFLUENCE_MIN_CONFIDENCE_STRONG=78
# CONFLUENCE_MIN_CONFIDENCE_SETUP=62
