LOCAL_API_TOKEN=local-dev-token-change-me
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://187.77.142.118:8000
# Optional cloud LLM — NEVER put this in the EA or browser
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-sol
USE_LLM=false
MAX_RESPONSE_AGE_SECONDS=120
# Position risk bands (% of equity at SL)
RISK_LOW_MAX_PCT=1.0
RISK_MODERATE_MAX_PCT=2.0
RISK_HIGH_MAX_PCT=5.0
RISK_VERY_HIGH_MAX_PCT=10.0
