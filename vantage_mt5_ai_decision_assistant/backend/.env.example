FLOAT_PROFIT_TARGET_PCT=10.0
RSI_EXHAUST=32.0

# Telegram Bot alerts (backend only — create via @BotFather)
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_COOLDOWN_SEC=300
TELEGRAM_ALERT_RISK=true
TELEGRAM_ALERT_FLOAT_TARGET=true
TELEGRAM_ALERT_ENTRY=true
TELEGRAM_ALERT_SIGNALS=true
TELEGRAM_ALERT_SWING=true
TELEGRAM_ALERT_LIQUIDITY_GRAB=true
TELEGRAM_ALERT_GOLD_SMC=true
