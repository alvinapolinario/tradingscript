# Copy to .env next to docker-compose.yml before: docker compose up -d
#   cp .env.docker.example .env

LOCAL_API_TOKEN=change-me-to-a-long-random-token
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://YOUR_SERVER:8000

# Optional cloud LLM — never put this in the EA
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-sol
USE_LLM=false
MAX_RESPONSE_AGE_SECONDS=120

RISK_LOW_MAX_PCT=1.0
RISK_MODERATE_MAX_PCT=2.0
RISK_HIGH_MAX_PCT=5.0
RISK_VERY_HIGH_MAX_PCT=10.0
MAX_POSITION_RISK_PCT=2.0
FLOAT_PROFIT_TARGET_PCT=10.0
RSI_EXHAUST=32.0

# Executor order sanity checks (applied before an order is reserved)
EXECUTION_MIN_RR=1.0
EXECUTION_MAX_SL_ATR=3.0
EXECUTION_MAX_ENTRY_DRIFT_ATR=0.5

# Backtest evidence — see docs/STRATEGY_RESEARCH.md
# STRATEGY_SCORECARD_PATH=          # default: <data dir>/strategy_scorecard.json
EVIDENCE_GATE_ENABLED=false
# CORS_EXTRA_ORIGINS=https://trading.example.com

# Market news / macro intelligence
MARKET_NEWS_ENABLED=true
NEWS_RISK_HIGH_BEFORE=30
NEWS_RISK_HIGH_AFTER=15
MARKET_NEWS_AI_ENABLED=false
DISCORD_MACRO_ALERTS_ENABLED=false
# DISCORD_MACRO_WEBHOOK_URL=
MARKET_NEWS_RSS_ENABLED=false
# MARKET_NEWS_RSS_FEEDS=
MARKET_NEWS_API_ENABLED=false
# NEWSAPI_KEY=
MARKET_NEWS_MAJOR_PAIRS=XAUUSD,EURUSD,USDJPY
